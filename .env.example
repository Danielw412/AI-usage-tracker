# ---------------------------------------------------------------------------
# Providers. Each one can be turned off; the dashboard shows a switch for the
# ones that are on. DEFAULT_PROVIDER picks the tab that opens first.
# ---------------------------------------------------------------------------
CODEX=true
CLAUDE_CODE=true
DEFAULT_PROVIDER=codex

# ---------------------------------------------------------------------------
# Codex
# ---------------------------------------------------------------------------
# Optional. Defaults to `codex` from PATH.
CODEX_BIN=codex

# Optional. Defaults to ~/.codex.
# CODEX_HOME=C:\\Users\\YourName\\.codex

# Polling intervals in milliseconds.
RATE_LIMIT_POLL_MS=60000
ACCOUNT_USAGE_POLL_MS=900000
THREAD_METADATA_POLL_MS=900000
SESSION_SCAN_MS=120000

# Codex Cloud task polling through `codex cloud list --json`. Set CLOUD_TASKS=false to skip it.
CLOUD_TASK_POLL_MS=600000
CLOUD_TASKS=true

# ---------------------------------------------------------------------------
# Claude Code
# ---------------------------------------------------------------------------
# Optional. Defaults to ~/.claude (the same folder Claude Code uses).
# CLAUDE_CONFIG_DIR=C:\\Users\\YourName\\.claude

# Optional. A long-lived token from `claude setup-token`. Without it the
# dashboard reads the sign-in Claude Code already stored.
# CLAUDE_CODE_OAUTH_TOKEN=

# How often the usage endpoint behind Claude Code's /usage screen is polled, and
# how often local transcripts are re-scanned. Both in milliseconds.
CLAUDE_USAGE_POLL_MS=120000
CLAUDE_SESSION_SCAN_MS=120000

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# Set to true to run the dashboard with generated sample data for both providers.
DEMO_MODE=false

PORT=8893

# Print adapter and parser diagnostics.
# DEBUG_AI_USAGE_TRACKER=true
# DEBUG_USAGE_DASHBOARD=true is still accepted for compatibility.
