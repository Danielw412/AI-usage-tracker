# ---------------------------------------------------------------------------
# Multi-device tracking. See "Multiple devices" in README.md.
# ---------------------------------------------------------------------------
# standalone  One machine, as before: scans its sessions, polls quota, serves
#             the dashboard. No sync API. This is the default.
# server      The central machine: everything standalone does, plus it accepts
#             usage events from collectors and attributes quota across devices.
# collector   Scans this machine's Codex and Claude Code sessions and sends the
#             events to the server through a durable local queue. Does not poll
#             account quota and does not serve the dashboard.
TRACKER_ROLE=standalone

# Stable identifier for this machine; every event it produces carries it.
# Defaults to the hostname, remembered in data/device.json on first start.
# Letters, digits, ".", "_" and "-" only. Give each machine its own.
# DEVICE_ID=laptop
# Name shown in the dashboard. Defaults to DEVICE_ID.
# DEVICE_LABEL=Laptop

# Shared secret for the sync API: the same value on the server and every
# collector. Required for server and collector. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SYNC_SECRET=

# Collectors only: the central server's address, for example its Tailscale
# MagicDNS name and the server's PORT.
# CENTRAL_URL=http://my-server:8893

# Optional sync tuning (milliseconds unless noted).
# SYNC_BATCH_SIZE=500          # records per upload request
# SYNC_DEBOUNCE_MS=2500        # coalesce bursts of local changes before uploading
# SYNC_HEARTBEAT_MS=90000      # status report and retry cadence while idle
# SYNC_MAX_BACKOFF_MS=300000   # longest wait between retries while the server is unreachable
# SYNC_DEVICE_RETIRE_DAYS=30   # a collector silent this long no longer holds attribution provisional

# Index transcripts the moment they change (file-system notifications), on top
# of the periodic SESSION_SCAN_MS scan that catches anything a notification missed.
WATCH_SESSIONS=true

# Poll account quota, account details, and Codex Cloud tasks. Defaults to true,
# and to false on collectors so only the central server asks the account.
# QUOTA_POLLING=true

# Listen on one address only, for example the machine's Tailscale IP. Defaults
# to every interface.
# HOST=

# Folder for the databases, device identity, and sync state. Defaults to ./data.
# DATA_DIR=

# ---------------------------------------------------------------------------
# Providers. Each one can be turned off; the dashboard shows a switch for the
# ones that are on. DEFAULT_PROVIDER picks the tab that opens first.
# ---------------------------------------------------------------------------
CODEX=true
CLAUDE_CODE=true
DEFAULT_PROVIDER=codex

# ---------------------------------------------------------------------------
# Codex
# ---------------------------------------------------------------------------
# Optional. Defaults to `codex` from PATH. Use an absolute path under systemd.
CODEX_BIN=codex

# Optional. Defaults to ~/.codex.
# CODEX_HOME=C:\\Users\\YourName\\.codex

# Polling intervals in milliseconds.
RATE_LIMIT_POLL_MS=60000
ACCOUNT_USAGE_POLL_MS=900000
THREAD_METADATA_POLL_MS=900000
# Full reconciliation scan of session logs (file notifications handle the rest).
SESSION_SCAN_MS=120000

# Codex Cloud task polling through `codex cloud list --json`. Set CLOUD_TASKS=false to skip it.
CLOUD_TASK_POLL_MS=600000
CLOUD_TASKS=true

# ---------------------------------------------------------------------------
# Claude Code
# ---------------------------------------------------------------------------
# Optional. Defaults to ~/.claude (the same folder Claude Code uses).
# CLAUDE_CONFIG_DIR=C:\\Users\\YourName\\.claude

# Optional. A long-lived token from `claude setup-token`. Without it the
# dashboard reads the sign-in Claude Code already stored.
# CLAUDE_CODE_OAUTH_TOKEN=

# How often the usage endpoint behind Claude Code's /usage screen is polled, and
# how often local transcripts are fully re-scanned. Both in milliseconds.
CLAUDE_USAGE_POLL_MS=120000
CLAUDE_SESSION_SCAN_MS=120000

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# Set to true to run the dashboard with generated sample data for both providers.
DEMO_MODE=false

PORT=8893

# Print adapter and parser diagnostics.
# DEBUG_AI_USAGE_TRACKER=true
# DEBUG_USAGE_DASHBOARD=true is still accepted for compatibility.
